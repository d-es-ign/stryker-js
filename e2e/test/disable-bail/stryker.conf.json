{
  "$schema": "../../node_modules/@d-es-ign/stryker-js-core/schema/stryker-schema.json",
  "concurrency": 1,
  "reporters": ["json"],
  "disableBail": true,
  "testRunnerNodeArgs": ["--experimental-vm-modules"],
  "karma": {
    "configFile": "karma.conf.cjs"
  },
  "tap": {
    "testFiles": ["test/*.tap.js"]
  },
  "plugins": [
    "@d-es-ign/stryker-js-karma-runner",
    "@d-es-ign/stryker-js-tap-runner",
    "@d-es-ign/stryker-js-jasmine-runner",
    "@d-es-ign/stryker-js-jest-runner",
    "@d-es-ign/stryker-js-mocha-runner",
    "@d-es-ign/stryker-js-cucumber-runner",
    "@d-es-ign/stryker-js-vitest-runner"
  ]
}

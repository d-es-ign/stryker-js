{
  "$schema": "../../node_modules/@d-es-ign/stryker-js-core/schema/stryker-schema.json",
  "mutate": [
    "src/data-access/mappers/TableStorageMapper.ts",
    "src/components/hello-component.ts"
  ],
  "packageManager": "npm",
  "testRunner": "jest",
  "tempDirName": "stryker-tmp",
  "concurrency": 2,
  "checkers": ["typescript"],
  "coverageAnalysis": "off",
  "reporters": ["progress", "html", "json"],
  "plugins": ["@d-es-ign/stryker-js-jest-runner", "@d-es-ign/stryker-js-typescript-checker"]
}

{
  "$schema": "../../node_modules/@d-es-ign/stryker-js-core/schema/stryker-schema.json",
  "testRunner": "mocha",
  "concurrency": 2,
  "coverageAnalysis": "perTest",
  "mutator": {
    "excludedMutations": ["ArithmeticOperator", "BlockStatement"]
  },
  "reporters": [
    "clear-text",
    "html",
    "json",
    "event-recorder"
  ],
  "ignorers": ["ConsoleIgnorer"],
  "plugins": [
    "@d-es-ign/stryker-js-mocha-runner",
    "./stryker-plugins/ignorers/console-ignorer.js"
  ],
  "allowConsoleColors": false
}
